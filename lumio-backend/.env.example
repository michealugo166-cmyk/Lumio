# Copy this file to .env and fill in real values. .env is gitignored and
# never committed — this file documents what's required.

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lumio

# Set to "true" for hosted MySQL providers (e.g. Aiven) that require TLS.
# Leave unset for local MySQL.
DB_SSL=false
# Paste the provider's CA certificate (PEM format) here when DB_SSL=true.
DB_CA_CERT=

JWT_SECRET=change-this-to-a-long-random-string

# Gmail address to send reset emails FROM, and a 16-char Gmail App Password
# (Google Account → Security → 2-Step Verification → App passwords).
# Regular Gmail passwords will NOT work here.
EMAIL_USER=
EMAIL_PASS=

# Where the reset link in the email should point (your deployed frontend origin)
FRONTEND_URL=http://localhost:5180

# Comma-separated list of additional allowed CORS origins (e.g. your Netlify URL)
EXTRA_CORS_ORIGINS=

PORT=4000
